# Copy to docker/.env (never commit real keys).
XAI_API_KEY=
# Docker Desktop / host RimAPI (RLE docker.py DEFAULT_PORT = 8765)
RIMAPI_URL=http://host.docker.internal:8765
# Optional: absolute path to an auth.json *file* (not ~/.grok)
# GROK_AUTH_JSON_MOUNT=/absolute/path/to/auth.json
# When pairing with RLE compose (service hostname `rimworld`):
# RIMAPI_URL=http://rimworld:8765
# RLE_COMPOSE_NETWORK=docker_default
